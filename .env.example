# Conv-way Environment Variables & Worker Secrets Template

# 1. Google Cloud APIs (YouTube Data API v3 & Optional Legacy CSE)
YOUTUBE_DATA_API_KEY="your-google-api-key"
WEB_SEARCH_API_KEY="your-google-api-key"
WEB_SEARCH_CX="819f7245209624657"

# 2. Managed YouTube Transcript Providers
SUPADATA_API_KEY="sd_..."
TRANSCRIPT_API_FALLBACK_KEY="sk_..."

# 3. Grounded Web Search Providers (Trusted Sites First & Open Web Fallback)
TAVILY_API_KEY="tvly-dev-..."
EXA_API_KEY="your-exa-api-key"
SEARCH_ORDER_TRUSTED="google_cse,tavily,exa"
SEARCH_ORDER_OPEN="tavily,exa"
SEARCH_MAX_PER_QUESTION=2
SEARCH_DAILY_CAP=30
GOOGLE_CSE_ENABLED=true
GOOGLE_CSE_SUNSET="2027-01-01"
GOOGLE_CSE_DAILY_CAP=90
SEARCH_CACHE_TTL_DAYS=7

# 4. Gnani AI Suite (Prisma v3.0, Evon v3.3, Timbre)
GNANI_API_KEY="your-gnani-api-key"
GNANI_ACCESS_TOKEN="your-gnani-access-token"
GNANI_EVON_ENDPOINT_URL="https://api.gnani.ai/v3/evon"
GNANI_PRISMA_ENDPOINT_URL="https://api.gnani.ai/v3/prisma"
GNANI_TIMBRE_ENDPOINT_URL="https://api.gnani.ai/v3/timbre"

# 5. Security & Administrative Calibration
ADMIN_CALIBRATION_SECRET="your-admin-secret"
IP_HASH_SALT="your-32-character-random-salt"

