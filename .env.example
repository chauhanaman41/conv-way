# ==============================================================================
# CONV-WAY ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this template to .dev.vars for local development with wrangler.
# For production deployment, set secret values via: npx wrangler secret put <NAME>
# NEVER commit .dev.vars or any file containing real secret keys to version control.

# ==============================================================================
# 1. REQUIRED FOR CORE FLOW
# ==============================================================================
# Required: YouTube Data API v3 key for discovering trending podcasts and fetching video details
YOUTUBE_DATA_API_KEY=

# Required: Primary API key for fetching native spoken transcripts via Supadata
SUPADATA_API_KEY=

# Required: Secondary fallback API key for fetching transcripts when primary is unavailable
TRANSCRIPT_API_FALLBACK_KEY=

# Required: Secret token for authenticating admin calibration and governor endpoints (/api/admin/*)
ADMIN_CALIBRATION_SECRET=

# Required: Salt string used for irreversible SHA-256 IP address hashing for privacy-safe rate limiting
IP_HASH_SALT=

# ==============================================================================
# 2. OPTIONAL (Feature gracefully disabled if key is missing)
# ==============================================================================
# Optional: Tavily API key for grounded web search fallback (Pass 1 trusted sites and Pass 2 open web)
TAVILY_API_KEY=

# Optional: Exa API key for neural open-web search fallback
EXA_API_KEY=

# Optional: Google Custom Search JSON API key (legacy/fallback for trusted domain search)
WEB_SEARCH_API_KEY=

# Optional: Google Custom Search Engine ID (paired with WEB_SEARCH_API_KEY)
WEB_SEARCH_CX=

# Optional: Gnani API key for Evon prediction/rerank, Prisma ASR transcription, and Timbre voice synthesis
GNANI_API_KEY=

# ==============================================================================
# 3. WORKERS AI BINDING (Configured in wrangler.toml)
# ==============================================================================
# No API key is required when the Cloudflare Workers AI binding is configured in wrangler.toml:
#   [ai]
#   binding = "AI"
# Edge model inference runs directly on Cloudflare global network infrastructure.

# ==============================================================================
# 4. BUDGET AND CAP SETTINGS (Defaults configured in wrangler.toml [vars])
# ==============================================================================
# Optional (default in wrangler.toml: "production"): Runtime environment ("development" or "production")
ENVIRONMENT=

# Optional (default in wrangler.toml: "true"): Enable Cloudflare Workers AI model inference for Way questions and search synthesis
LLM_WORKERS_AI_ENABLED=

# Optional (default in wrangler.toml: "workers_ai,evon"): Priority order for LLM synthesis providers
LLM_PROVIDER_ORDER=

# Optional (default in wrangler.toml: "@cf/meta/llama-3.2-3b-instruct"): Default Workers AI model identifier
WORKERS_AI_MODEL=

# Optional (default in wrangler.toml: "google_cse,tavily,exa"): Priority order for Pass 1 trusted-domain web search
SEARCH_ORDER_TRUSTED=

# Optional (default in wrangler.toml: "tavily,exa"): Priority order for Pass 2 open-web search fallback
SEARCH_ORDER_OPEN=

# Optional (default in wrangler.toml: "2"): Maximum search queries executed per question
SEARCH_MAX_PER_QUESTION=

# Optional (default in wrangler.toml: "30"): Daily cap on total search API queries
SEARCH_DAILY_CAP=

# Optional (default in wrangler.toml: "true"): Enable Google Custom Search Engine in Pass 1
GOOGLE_CSE_ENABLED=

# Optional (default in wrangler.toml: "2027-01-01"): Sunset cutoff date after which Google CSE automatically disables
GOOGLE_CSE_SUNSET=

# Optional (default in wrangler.toml: "90"): Daily cap on Google CSE queries
GOOGLE_CSE_DAILY_CAP=

# Optional (default in wrangler.toml: "7"): Retention period in days for cached web search responses in D1
SEARCH_CACHE_TTL_DAYS=

# Optional (default in wrangler.toml: "3000"): Total credit allocation for Gnani speech/AI services
GNANI_TOTAL_CREDIT_BUDGET=

# Optional (default in wrangler.toml: "2026-12-15"): Expiration date for Gnani credit cycle
GNANI_BUDGET_END_DATE=

# Optional (default in wrangler.toml: "0.10"): Percentage of credit budget reserved for high-priority tasks
GNANI_RESERVE_RATIO=

# Optional (default in wrangler.toml: "90"): Daily YouTube API search quota units
YOUTUBE_DAILY_SEARCH_BUDGET=

# Optional (default in wrangler.toml: "5"): Daily limit on native transcript fetches to stay within free tier budget
DAILY_TRANSCRIPT_FETCH_BUDGET=

# Optional (default in wrangler.toml: "400"): Maximum storage ceiling in megabytes for local/remote SQLite D1 database
D1_STORAGE_LIMIT_MB=
